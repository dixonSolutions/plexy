[0.044, "o", "\u001b[1;34m::\u001b[0m new deployment: /ostree/deploy/default/deploy/511672af201bbd8f470d3c5e8fe0d7197cf7af9d61a620e8593198bbf68c6224.0\r\n"]
[0.001, "o", "\u001b[1;34m::\u001b[0m fstab entries carried: 2\r\n\u001b[1;32m==>\u001b[0m \u001b[1mmerging user accounts\u001b[0m\r\n"]
[0.001, "o", "\u001b[1;34m::\u001b[0m   user tester (uid 1000), groups: adm, wheel, sudo\r\n\u001b[1;32m==>\u001b[0m \u001b[1mcarrying configuration into the new /etc\u001b[0m\r\n"]
[0.001, "o", "\u001b[1;34m::\u001b[0m   14 config files written\r\n\u001b[1;32m==>\u001b[0m \u001b[1mre-enabling services\u001b[0m\r\n"]
[0.090, "o", "\u001b[1;34m::\u001b[0m   disabled lvm-devices-import.path (it was disabled on the old system)\r\n"]
[0.005, "o", "\u001b[1;34m::\u001b[0m   disabled lvm-devices-import.service (it was disabled on the old system)\r\n\u001b[1;34m::\u001b[0m   38 units enabled as on the old system\r\n\u001b[1;34m::\u001b[0m   9 units have no counterpart on the target: audit-rules.service auditd.service cloud-config.service cloud-final.service cloud-init-local.service cloud-init-main.service qemu-guest-agent.service sssd-kcm.socket unbound-anchor.timer\r\n"]
[0.011, "o", "\u001b[1;32m==>\u001b[0m \u001b[1minstalling first-boot and first-login hooks\u001b[0m\r\n"]
[0.034, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mremapping ownership of system accounts (8 uids, 10 gids differ)\u001b[0m\r\n"]
[0.034, "o", "\u001b[1;34m::\u001b[0m   24 files re-owned\r\n\u001b[1;32m==>\u001b[0m \u001b[1mlabelling migrated files with the target's SELinux policy\u001b[0m\r\n\u001b[1;34m::\u001b[0m $ podman run --rm --privileged --net=none --security-opt label=disable -v /ostree/deploy/default/deploy/511672af201bbd8f470d3c5e8fe0d7197cf7af9d61a620e8593198bbf68c6224.0/etc:/target/etc --mount type=bind,source=/var/roothome,destination=/target/var/roothome,bind-nonrecursive --mount type=bind,source=/var/usrlocal,destination=/target/var/usrlocal,bind-nonrecursive --mount type=bind,source=/var/lib/plexy,destination=/target/var/lib/plexy,bind-nonrecursive --rootfs /ostree/deploy/default/deploy/511672af201bbd8f470d3c5e8fe0d7197cf7af9d61a620e8593198bbf68c6224.0:O /usr/sbin/setfiles -F -r /target /etc/selinux/targeted/contexts/files/file_contexts /target/etc /target/var/roothome /target/var/usrlocal /target/var/lib/plexy\r\n"]
[0.276, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mmigration staged\u001b[0m\r\n\r\n  The new system is installed and your data has been placed. Reboot to start it.\r\n  The old system's files remain under /sysroot until you run `plexy cleanup`.\r\n\r\n"]
[0.050, "x", "0"]
