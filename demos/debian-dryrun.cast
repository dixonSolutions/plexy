[0.035, "o", "\u001b[1;34m::\u001b[0m the system will follow ghcr.io/ublue-os/bluefin:stable directly; 1 package(s) are layered with rpm-ostree on first boot\r\n"]
[0.022, "o", "\r\n  About to replace the operating system with ghcr.io/ublue-os/bluefin:stable (Bootc backend).\r\n  /boot and the EFI boot entries will be rewritten; data, accounts and settings are carried over.\r\n  A backup of /boot and the ESP is written to /var/lib/plexy/backup (`plexy rollback` uses it).\r\n"]
[0.025, "o", "\u001b[1;32m==>\u001b[0m \u001b[1minstalling ghcr.io/ublue-os/bluefin:stable next to the running system (bootc install to-existing-root)\u001b[0m\r\n\u001b[1;34m::\u001b[0m [dry-run] podman run --rm --net=none --privileged --pid=host --user=root:root -v /dev:/dev -v /var/lib/containers:/var/lib/containers -v /:/target --security-opt label=type:unconfined_t ghcr.io/ublue-os/bluefin:stable bootc install to-existing-root --acknowledge-destructive --skip-fetch-check --stateroot=default --target-imgref=ghcr.io/ublue-os/bluefin:stable --karg=console=tty0 --karg=console=ttyS0,115200 --karg=consoleblank=0\r\n\u001b[1;34m::\u001b[0m new deployment: /ostree/deploy/default/deploy/DRYRUN.0\r\n\u001b[1;34m::\u001b[0m fstab entries carried: 0\r\n\u001b[1;32m==>\u001b[0m \u001b[1mmerging user accounts\u001b[0m\r\n"]
[0.001, "o", "\u001b[1;34m::\u001b[0m [dry-run] write /ostree/deploy/default/deploy/DRYRUN.0/etc/passwd\r\n\u001b[1;34m::\u001b[0m [dry-run] write /ostree/deploy/default/deploy/DRYRUN.0/etc/shadow\r\n\u001b[1;34m::\u001b[0m [dry-run] write /ostree/deploy/default/deploy/DRYRUN.0/etc/group\r\n\u001b[1;34m::\u001b[0m [dry-run] write /ostree/deploy/default/deploy/DRYRUN.0/etc/gshadow\r\n\u001b[1;34m::\u001b[0m [dry-run] write /ostree/deploy/default/deploy/DRYRUN.0/etc/subuid\r\n\u001b[1;34m::\u001b[0m [dry-run] write /ostree/deploy/default/deploy/DRYRUN.0/etc/subgid\r\n\u001b[1;34m::\u001b[0m   user tester (uid 1000), groups: adm, sudo, wheel\r\n\u001b[1;32m==>\u001b[0m \u001b[1mcarrying configuration into the new /etc\u001b[0m\r\n\u001b[1;34m::\u001b[0m [dry-run] /etc/default/locale → /etc/locale.conf\r\n\u001b[1;34m::\u001b[0m [dry-run] /etc/hostname → /etc/hostname\r\n\u001b[1;34m::\u001b[0m [dry-run] /etc/hosts → /etc/hosts\r\n\u001b[1;34m::\u001b[0m [dry-run] /etc/inputrc → /etc/inputrc\r\n\u001b[1;34m::\u001b[0m [dry-run] /etc/locale.conf → /etc/locale.conf\r\n\u001b[1;34m::\u001b[0m [dry-run] /etc/localtime → /etc/localtime\r\n\u001b[1;34m::\u001b[0m [dry-run] /etc/machine-id → /etc/machine-id\r\n\u001b[1;34m::\u001b[0m [dry-run] /etc/modprobe.d/blacklist.conf → /etc/modprobe.d/blacklist.conf\r\n\u001b[1;34m::\u001b[0m [dry-run] /etc/nginx/sites-enabled/default → /etc/nginx/sites-enabled/default\r\n\u001b[1;34m::\u001b[0m [dry-run] /etc/ssh/ssh_host_ecdsa_key → /etc/ssh/ssh_host_ecdsa_key\r\n\u001b[1;34m::\u001b[0m [dry-run] /etc/ssh/ssh_host_ecdsa_key.pub → /etc/ssh/ssh_host_ecdsa_key.pub\r\n\u001b[1;34m::\u001b[0m [dry-run] /etc/ssh/ssh_host_ed25519_key → /etc/ssh/ssh_host_ed25519_key\r\n\u001b[1;34m::\u001b[0m [dry-run] /etc/ssh/ssh_host_ed25519_key.pub → /etc/ssh/ssh_host_ed25519_key.pub\r\n\u001b[1;34m::\u001b[0m [dry-run] /etc/ssh/ssh_host_rsa_key → /etc/ssh/ssh_host_rsa_key\r\n\u001b[1;34m::\u001b[0m [dry-run] /etc/ssh/ssh_host_rsa_key.pub → /etc/ssh/ssh_h