[0.245, "o", "\r\n  About to replace the operating system with ghcr.io/ublue-os/bluefin:stable (Bootc backend).\r\n  /boot and the EFI boot entries will be rewritten; data, accounts and settings are carried over.\r\n  A backup of /boot and the ESP is written to /var/lib/plexy/backup (`plexy rollback` uses it).\r\n"]
[0.030, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mbacking up /boot and the EFI system partition to /var/lib/plexy/backup\u001b[0m\r\n"]
[0.476, "o", "\u001b[1;32m==>\u001b[0m \u001b[1minstalling ghcr.io/ublue-os/bluefin:stable next to the running system (bootc install to-existing-root)\u001b[0m\r\n\u001b[1;34m::\u001b[0m $ podman run --rm --net=none --privileged --pid=host --user=root:root -v /dev:/dev -v /var/lib/containers:/var/lib/containers -v /:/target --security-opt label=type:unconfined_t ghcr.io/ublue-os/bluefin:stable bootc install to-existing-root --acknowledge-destructive --skip-fetch-check --stateroot=default --target-imgref=ghcr.io/ublue-os/bluefin:stable\r\n"]
