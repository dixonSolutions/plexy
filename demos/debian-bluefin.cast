[5.632, "o", "\r\n  source : Debian GNU/Linux 13 (trixie) (Debian, desktop: none (headless))\r\n  target : bluefin [ghcr.io/ublue-os/bluefin:stable] (Fedora, desktop: GNOME, backend: Bootc)\r\n  mode   : Hybrid\r\n\r\n  already in target image            4 package(s)\r\n  layer into system image            1 package(s)\r\n      nginx\r\n  Homebrew                           2 package(s)\r\n      neovim  ripgrep\r\n\r\n  config files: 19 → /etc, 0 → toolbox, 0 → brew, 592 skipped\r\n\r\n"]
[0.002, "o", "\u001b[1;34m::\u001b[0m plan written to /var/lib/plexy/plan/plan.json\r\n\u001b[1;34m::\u001b[0m review or edit /var/lib/plexy/plan/{plan.json,system/Containerfile,toolbox/Containerfile}\r\n"]
[0.027, "o", "\u001b[1;34m::\u001b[0m the system will follow ghcr.io/ublue-os/bluefin:stable directly; 1 package(s) are layered with rpm-ostree on first boot\r\n"]
[0.023, "o", "\r\n  About to replace the operating system with ghcr.io/ublue-os/bluefin:stable (Bootc backend).\r\n  /boot and the EFI boot entries will be rewritten; data, accounts and settings are carried over.\r\n  A backup of /boot and the ESP is written to /var/lib/plexy/backup (`plexy rollback` uses it).\r\n"]
[0.028, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mbacking up /boot and the EFI system partition to /var/lib/plexy/backup\u001b[0m\r\n"]
[0.445, "o", "\u001b[1;32m==>\u001b[0m \u001b[1minstalling ghcr.io/ublue-os/bluefin:stable next to the running system (bootc install to-existing-root)\u001b[0m\r\n\u001b[1;34m::\u001b[0m $ podman run --rm --net=none --privileged --pid=host --user=root:root -v /dev:/dev -v /var/lib/containers:/var/lib/containers -v /:/target --security-opt label=type:unconfined_t ghcr.io/ublue-os/bluefin:stable bootc install to-existing-root --acknowledge-destructive --skip-fetch-check --stateroot=default --target-imgref=ghcr.io/ublue-os/bluefin:stable --karg=console=tty0 --karg=console=ttyS0,115200 --karg=consoleblank=0\r\n"]
[1.145, "o", "Installing image: docker://ghcr.io/ublue-os/bluefin:stable\r\nDigest: sha256:e4b5303ca69e80245ffd8841e4aacaa906c24a328da0621e970688faa07ce460\r\n"]
