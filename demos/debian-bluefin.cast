[0.000, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mre-enabling services\u001b[0m\r\n"]
[0.028, "o", "\u001b[1;34m::\u001b[0m   7 units enabled as on the old system\r\n\u001b[1;34m::\u001b[0m   18 units have no counterpart on the target: apparmor.service apt-daily-upgrade.timer apt-daily.timer apt-listchanges.timer cloud-config.service cloud-final.service cloud-init-hotplugd.socket cloud-init-local.service cloud-init-main.service cloud-init-network.service dpkg-db-backup.timer e2scrub_all.timer e2scrub_reap.service grub-common.service man-db.timer sshd-keygen.service unattended-upgrades.service uuidd.socket\r\n\u001b[1;32m==>\u001b[0m \u001b[1mmoving /var contents into /ostree/deploy/default/var\u001b[0m\r\n"]
[0.001, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mmoving /home into /ostree/deploy/default/var/home\u001b[0m\r\n"]
[0.001, "o", "\u001b[1;32m==>\u001b[0m \u001b[1minstalling first-boot and first-login hooks\u001b[0m\r\n"]
[0.007, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mremapping ownership of system accounts (10 uids, 25 gids differ)\u001b[0m\r\n"]
[0.019, "o", "\u001b[1;34m::\u001b[0m   13 files re-owned\r\n\u001b[1;32m==>\u001b[0m \u001b[1mlabelling migrated files with the target's SELinux policy\u001b[0m\r\n\u001b[1;34m::\u001b[0m $ podman run --rm --privileged --net=none --security-opt label=disable -v /ostree/deploy/default/deploy/f12beaab0a99a0433ad905e8152cc2d5491f10f20f29cec44f2e88d46c56f4fd.0/etc:/target/etc --mount type=bind,source=/ostree/deploy/default/var,destination=/target/var,bind-nonrecursive --rootfs /ostree/deploy/default/deploy/f12beaab0a99a0433ad905e8152cc2d5491f10f20f29cec44f2e88d46c56f4fd.0:O /usr/sbin/setfiles -F -r /target /etc/selinux/targeted/contexts/files/file_contexts /target/etc /target/var\r\n"]
[5.987, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mmigration staged\u001b[0m\r\n\r\n  The new system is installed and your data has been placed. Reboot to start it.\r\n  The old system's files remain under /sysroot until you run `plexy cleanup`.\r\n\r\n"]
