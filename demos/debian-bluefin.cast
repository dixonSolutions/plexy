[0.002, "o", "\u001b[1;34m::\u001b[0m fstab entries carried: 0\r\n\u001b[1;32m==>\u001b[0m \u001b[1mmerging user accounts\u001b[0m\r\n"]
[0.001, "o", "\u001b[1;34m::\u001b[0m   user tester (uid 1000), groups: adm, sudo, wheel\r\n\u001b[1;32m==>\u001b[0m \u001b[1mcarrying configuration into the new /etc\u001b[0m\r\n\u001b[1;34m::\u001b[0m   skipping /etc/default/locale: its link target is not in the new system\r\n"]
