[0.000, "o", "\u001b[1;34m::\u001b[0m   15 config files written\r\n\u001b[1;32m==>\u001b[0m \u001b[1mre-enabling services\u001b[0m\r\n"]
[0.019, "o", "\u001b[1;34m::\u001b[0m   6 units enabled as on the old system\r\n\u001b[1;34m::\u001b[0m   19 units have no counterpart on the target: apparmor.service apt-daily-upgrade.timer apt-daily.timer apt-listchanges.timer cloud-config.service cloud-final.service cloud-init-hotplugd.socket cloud-init-local.service cloud-init-main.service cloud-init-network.service dpkg-db-backup.timer e2scrub_all.timer e2scrub_reap.service grub-common.service man-db.timer nginx.service sshd-keygen.service unattended-upgrades.service uuidd.socket\r\n\u001b[1;32m==>\u001b[0m \u001b[1mmoving /var contents into /ostree/deploy/default/var\u001b[0m\r\n"]
[0.001, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mmoving /home into /ostree/deploy/default/var/home\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;32m==>\u001b[0m \u001b[1minstalling first-boot and first-login hooks\u001b[0m\r\n"]
[0.005, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mremapping ownership of system accounts (10 uids, 25 gids differ)\u001b[0m\r\n"]
[0.011, "o", "\u001b[1;34m::\u001b[0m   13 files re-owned\r\n\u001b[1;32m==>\u001b[0m \u001b[1mlabelling migrated files with the target's SELinux policy\u001b[0m\r\n\u001b[1;34m::\u001b[0m $ podman run --rm --privileged --net=none --security-opt label=disable -v /ostree/deploy/default/deploy/e47a52e72131e5cfaaf656721caf4341e7bafa6236b4d7fa4fc29d2615dbe4f7.0/etc:/target/etc --mount type=bind,source=/ostree/deploy/default/var,destination=/target/var,bind-nonrecursive --rootfs /ostree/deploy/default/deploy/e47a52e72131e5cfaaf656721caf4341e7bafa6236b4d7fa4fc29d2615dbe4f7.0:O /usr/sbin/setfiles -F -r /target /etc/selinux/targeted/contexts/files/file_contexts /target/etc /target/var\r\n"]
[5.575, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mmigration staged\u001b[0m\r\n\r\n  The new system is installed and your data has been placed. Reboot to start it.\r\n  The old system's files remain under /sysroot until you run `plexy cleanup`.\r\n\r\n"]
