[0.003, "o", "\u001b[1;34m::\u001b[0m   28 config files written\r\n\u001b[1;32m==>\u001b[0m \u001b[1madding 10 repositories for packages layered on first boot\u001b[0m\r\n"]
[0.006, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mre-enabling services\u001b[0m\r\n"]
[0.258, "o", "\u001b[1;34m::\u001b[0m   disabled lvm-devices-import.path (it was disabled on the old system)\r\n"]
[0.006, "o", "\u001b[1;34m::\u001b[0m   disabled lvm-devices-import.service (it was disabled on the old system)\r\n\u001b[1;34m::\u001b[0m   68 units enabled as on the old system\r\n\u001b[1;34m::\u001b[0m   42 units have no counterpart on the target: atd.service cockpit.socket com.system76.Scheduler.service crond.service irqbalance.service iscsi-onboot.service iscsi-starter.service iscsid.socket iscsiuio.socket multipathd.service plocate-updatedb.timer rsyslog.service taidan-initial-setup-reconfiguration.service virtinterfaced-admin.socket virtinterfaced-ro.socket virtinterfaced.socket virtlockd-admin.socket virtlockd.socket virtlogd-admin.socket virtlogd.socket virtnetworkd-admin.socket virtnetworkd-ro.socket virtnetworkd.socket virtnodedevd-admin.socket virtnodedevd-ro.socket virtnodedevd.socket virtnwfilterd-admin.socket virtnwfilterd-ro.socket virtnwfilterd.socket virtproxyd-admin.socket virtproxyd-ro.socket virtproxyd.socket virtqemud-admin.socket virtqemud-ro.socket virtqemud.service virtqemud.socket virtsecretd-admin.socket virtsecretd-ro.socket virtsecretd.socket virtstoraged-admin.socket virtstoraged-ro.socket virtstoraged.socket\r\n\u001b[1;32m==>\u001b[0m \u001b[1mmoving /var contents into /ostree/deploy/default/var\u001b[0m\r\n"]
[0.005, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mmoving /home into /ostree/deploy/default/var/home\u001b[0m\r\n"]
[0.003, "o", "\u001b[1;32m==>\u001b[0m \u001b[1minstalling first-boot and first-login hooks\u001b[0m\r\n\u001b[1;32m==>\u001b[0m \u001b[1mremapping ownership of system accounts (26 uids, 29 gids differ)\u001b[0m\r\n"]
[0.015, "o", "\u001b[1;34m::\u001b[0m   46 files re-owned\r\n\u001b[1;32m==>\u001b[0m \u001b[1mlabelling migrated files with the target's SELinux policy\u001b[0m\r\n\u001b[1;34m::\u001b[0m $ podman run --rm --privileged --net=none --security-opt label=disable -v /ostree/deploy/default/deploy/e47a52e72131e5cfaaf656721caf4341e7bafa6236b4d7fa4fc29d2615dbe4f7.0/etc:/target/etc --mount type=bind,source=/ostree/deploy/default/var/roothome,destination=/target/var/roothome,bind-nonrecursive --mount type=bind,source=/ostree/deploy/default/var/usrlocal,destination=/target/var/usrlocal,bind-nonrecursive --mount type=bind,source=/ostree/deploy/default/var/lib/plexy,destination=/target/var/lib/plexy,bind-nonrecursive --rootfs /ostree/deploy/default/deploy/e47a52e72131e5cfaaf656721caf4341e7bafa6236b4d7fa4fc29d2615dbe4f7.0:O /usr/sbin/setfiles -F -r /target /etc/selinux/targeted/contexts/files/file_contexts /target/etc /target/var/roothome /target/var/usrlocal /target/var/lib/plexy\r\n"]
[0.198, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mmigration staged\u001b[0m\r\n\r\n  The new system is installed and your data has been placed. Reboot to start it.\r\n  The old system's files remain under /sysroot until you run `plexy cleanup`.\r\n\r\n"]
[0.003, "o", "\u001b[1;33mwarning:\u001b[0m rebooting past 2 block inhibitor(s) (the migration is staged):\r\nalice 1000 alice 1526 gsd-power      handle-lid-switch                                        External monitor attached or configuration changed recently block\r\nalice 1000 alice 1525 gsd-media-keys handle-power-key:handle-suspend-key:handle-hibernate-key GNOME handling keypresses                                   block\r\n"]
[0.040, "x", "0"]
