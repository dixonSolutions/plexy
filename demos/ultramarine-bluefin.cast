[0.000, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mlabelling migrated files with the target's SELinux policy\u001b[0m\r\n\u001b[1;34m::\u001b[0m $ podman run --rm --privileged --net=none --security-opt label=disable -v /ostree/deploy/default/deploy/c8191cd295da8ad19fb65cffaa5b123c26b2b3cfa5159bb02f76a8bb38343dfb.0/etc:/target/etc --mount type=bind,source=/ostree/deploy/default/var/roothome,destination=/target/var/roothome,bind-nonrecursive --mount type=bind,source=/ostree/deploy/default/var/usrlocal,destination=/target/var/usrlocal,bind-nonrecursive --mount type=bind,source=/ostree/deploy/default/var/lib/plexy,destination=/target/var/lib/plexy,bind-nonrecursive --rootfs /ostree/deploy/default/deploy/c8191cd295da8ad19fb65cffaa5b123c26b2b3cfa5159bb02f76a8bb38343dfb.0:O /usr/sbin/setfiles -F -r /target /etc/selinux/targeted/contexts/files/file_contexts /target/etc /target/var/roothome /target/var/usrlocal /target/var/lib/plexy\r\n"]
[0.227, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mmigration staged\u001b[0m\r\n\r\n  The new system is installed and your data has been placed. Reboot to start it.\r\n  The old system's files remain under /sysroot until you run `plexy cleanup`.\r\n\r\n"]
[0.004, "o", "\u001b[1;33mwarning:\u001b[0m rebooting past 2 block inhibitor(s) (the migration is staged):\r\nalice 1000 alice 1530 gsd-power      handle-lid-switch                                        External monitor attached or configuration changed recently block\r\nalice 1000 alice 1529 gsd-media-keys handle-power-key:handle-suspend-key:handle-hibernate-key GNOME handling keypresses                                   block\r\n"]
