[0.004, "o", "\r\n  About to replace the operating system with ghcr.io/vanilla-os/gnome:latest (Abroot backend).\r\n  New ABRoot volumes are created on the disk you named (its contents are erased);\r\n  this system is left untouched and stays bootable from the firmware menu.\r\n"]
[1.866, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mpartitioning /dev/vdb for ABRoot (vos-boot, vos-root LVM, vos-var)\u001b[0m\r\n"]
[0.983, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mcreating filesystems and the vos-root thin pool\u001b[0m\r\n\u001b[1;34m::\u001b[0m $ mkfs.vfat -F 32 -n VOS-EFI /dev/vdb1\r\n"]
[0.010, "o", "mkfs.fat 4.2 (2021-01-31)\r\n"]
[0.009, "o", "\u001b[1;34m::\u001b[0m $ mkfs.ext4 -q -F -L vos-boot /dev/vdb2\r\n"]
[0.009, "o", "\u001b[1;34m::\u001b[0m $ mkfs.btrfs -q -f -L vos-var /dev/vdb4\r\n"]
[0.363, "o", "\u001b[1;34m::\u001b[0m $ pvcreate -ff -y /dev/vdb3\r\n"]
[0.007, "o", "  Physical volume \"/dev/vdb3\" successfully created.\r\n"]
[0.011, "o", "\u001b[1;34m::\u001b[0m $ vgcreate vos-root /dev/vdb3\r\n"]
[0.019, "o", "  Volume group \"vos-root\" successfully created\r\n"]
[0.015, "o", "\u001b[1;34m::\u001b[0m $ lvcreate -y -L 1G -n init vos-root\r\n"]
[0.020, "o", "  Logical volume \"init\" created.\r\n"]
[0.015, "o", "\u001b[1;34m::\u001b[0m $ mkfs.ext4 -q -F -L vos-init /dev/vos-root/init\r\n"]
[0.008, "o", "\u001b[1;34m::\u001b[0m $ lvcreate -y -l 90%FREE -n root vos-root\r\n"]
[0.017, "o", "  Logical volume \"root\" created.\r\n"]
[0.011, "o", "\u001b[1;34m::\u001b[0m $ lvcreate -y -L 512M -n root-meta vos-root\r\n"]
[0.022, "o", "  Logical volume \"root-meta\" created.\r\n"]
[0.013, "o", "\u001b[1;34m::\u001b[0m $ lvconvert -y --type thin-pool --poolmetadata vos-root/root-meta vos-root/root\r\n"]
[0.027, "o", "  Thin pool volume with chunk size 64.00 KiB can address at most <15.88 TiB of data.\r\n  WARNING: Converting vos-root/root and vos-root/root-meta to thin pool's data and metadata volumes with metadata wiping.\r\n  THIS WILL DESTROY CONTENT OF LOGICAL VOLUME (filesystem etc.)\r\n"]
[0.068, "o", "  Converted vos-root/root and vos-root/root-meta to thin pool.\r\n"]
[0.068, "o", "\u001b[1;34m::\u001b[0m $ lvcreate -y -V 19G -T vos-root/root -n root-a\r\n"]
[0.547, "o", "  WARNING: Sum of all thin volume sizes (19.00 GiB) exceeds the size of thin pool vos-root/root and the amount of free space in volume group (1.10 GiB).\r\n  WARNING: You have not turned on protection against thin pools running out of space.\r\n  WARNING: Set activation/thin_pool_autoextend_threshold below 100 to trigger automatic extension of thin pools before they get full.\r\n"]
[0.543, "o", "  Logical volume \"root-a\" created.\r\n"]
[0.041, "o", "\u001b[1;34m::\u001b[0m $ lvcreate -y -V 19G -T vos-root/root -n root-b\r\n"]
[0.006, "o", "  WARNING: Sum of all thin volume sizes (38.00 GiB) exceeds the size of thin pool vos-root/root and the size of whole volume group (<22.00 GiB).\r\n  WARNING: You have not turned on protection against thin pools running out of space.\r\n  WARNING: Set activation/thin_pool_autoextend_threshold below 100 to trigger automatic extension of thin pools before they get full.\r\n"]
[0.022, "o", "  Logical volume \"root-b\" created.\r\n"]
[0.040, "o", "\u001b[1;34m::\u001b[0m $ mkfs.btrfs -q -f -L vos-a /dev/vos-root/root-a\r\n"]
[0.102, "o", "\u001b[1;34m::\u001b[0m $ mkfs.btrfs -q -f -L vos-b /dev/vos-root/root-b\r\n"]
[0.107, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mmounting the new root A\u001b[0m\r\n\u001b[1;34m::\u001b[0m $ mount /dev/vos-root/root-a /mnt/plexy-abroot/a\r\n"]
[0.009, "o", "\u001b[1;34m::\u001b[0m $ mount /dev/vdb4 /mnt/plexy-abroot/a/var\r\n"]
[0.010, "o", "\u001b[1;32m==>\u001b[0m \u001b[1munpacking localhost/plexy/vanilla:ubu1 into root A\u001b[0m\r\n"]
[20.225, "o", "\u001b[1;34m::\u001b[0m $ mount /dev/vdb2 /mnt/plexy-abroot/a/boot\r\n"]
[0.025, "o", "\u001b[1;34m::\u001b[0m $ mount /dev/vdb1 /mnt/plexy-abroot/a/boot/efi\r\n"]
[0.004, "o", "\u001b[1;32m==>\u001b[0m \u001b[1marranging the ABRoot filesystem structure\u001b[0m\r\n"]
[0.049, "o", "\u001b[1;34m::\u001b[0m $ mount -t overlay -o lowerdir=/mnt/plexy-abroot/a/etc,upperdir=/mnt/plexy-abroot/a/var/lib/abroot/etc/vos-a,workdir=/mnt/plexy-abroot/a/var/lib/abroot/etc/vos-a-work overlay /mnt/plexy-abroot/a/etc\r\n"]
[0.009, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mcarrying accounts and configuration\u001b[0m\r\n"]
[0.004, "o", "\u001b[1;34m::\u001b[0m   19 config files carried\r\n"]
[0.318, "o", "\u001b[1;34m::\u001b[0m   42 services enabled as on the old system\r\n\u001b[1;32m==>\u001b[0m \u001b[1minstalling the boot chain (initramfs, GRUB, EFI entry)\u001b[0m\r\n\u001b[1;34m::\u001b[0m $ mount --rbind /dev /mnt/plexy-abroot/a/dev\r\n"]
[0.000, "o", "\u001b[1;34m::\u001b[0m $ mount --rbind /proc /mnt/plexy-abroot/a/proc\r\n"]
[0.001, "o", "\u001b[1;34m::\u001b[0m $ mount --rbind /sys /mnt/plexy-abroot/a/sys\r\n"]
[0.001, "o", "\u001b[1;34m::\u001b[0m $ mount --rbind /run /mnt/plexy-abroot/a/run\r\n"]
[0.001, "o", "\u001b[1;34m::\u001b[0m $ mount /dev/vos-root/init /mnt/plexy-abroot/a/boot/init\r\n"]
[0.010, "o", "\u001b[1;34m::\u001b[0m $ chroot /mnt/plexy-abroot/a /bin/sh -c lpkg --unlock >/dev/null 2>&1; rc=0; if [ -e /boot/initrd.img-7.1.3+deb14-amd64 ]; then update-initramfs -u -k 7.1.3+deb14-amd64 || rc=$?; else update-initramfs -c -k 7.1.3+deb14-amd64 || rc=$?; fi; lpkg --lock >/dev/null 2>&1; exit $rc\r\n"]
[0.014, "o", "update-initramfs: Generating /boot/initrd.img-7.1.3+deb14-amd64\r\n"]
[14.397, "o", "\u001b[1;34m::\u001b[0m $ chroot /mnt/plexy-abroot/a /bin/sh -c grub-install --no-nvram --bootloader-id=vanilla --boot-directory=/boot --target=x86_64-efi --efi-directory=/boot/efi --uefi-secure-boot\r\n"]
[0.010, "o", "Installing for x86_64-efi platform.\r\n"]
[0.163, "o", "Installation finished. No error reported.\r\n"]
[0.004, "o", "\u001b[1;34m::\u001b[0m $ efibootmgr --create --disk /dev/vdb --part 1 --label Vanilla OS --loader \\EFI\\vanilla\\shimx64.efi\r\n"]
[0.022, "o", "BootCurrent: 0003\r\n"]
