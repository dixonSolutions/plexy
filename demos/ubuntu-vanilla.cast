[0.067, "o", "\u001b[1;34m::\u001b[0m   11 files re-owned for system accounts whose ids differ\r\n"]
[0.010, "o", "\u001b[1;32m==>\u001b[0m \u001b[1munmounting\u001b[0m\r\n"]
[0.157, "o", "\r\n  Vanilla OS is installed on ABRoot volumes and is now the first boot entry.\r\n  Your previous system is untouched and stays available in the firmware boot menu.\r\n\r\n"]
[0.010, "x", "0"]
