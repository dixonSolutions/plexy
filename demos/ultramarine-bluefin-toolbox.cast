[0.001, "o", "\u001b[1A\u001b[JCopying config b0ef84a3e1 done   | \r\nWriting manifest to image destination\r\n"]
[2.058, "o", "\r\n  About to replace the operating system with ghcr.io/ublue-os/bluefin:stable (Bootc backend).\r\n  /boot and the EFI boot entries will be rewritten; data, accounts and settings are carried over.\r\n  A backup of /boot and the ESP is written to /var/lib/plexy/backup (`plexy rollback` uses it).\r\n"]
[0.032, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mbacking up /boot and the EFI system partition to /var/lib/plexy/backup\u001b[0m\r\n"]
[0.331, "o", "\u001b[1;32m==>\u001b[0m \u001b[1minstalling ghcr.io/ublue-os/bluefin:stable next to the running system (bootc install to-existing-root)\u001b[0m\r\n\u001b[1;34m::\u001b[0m $ podman run --rm --net=none --privileged --pid=host --user=root:root -v /dev:/dev -v /var/lib/containers:/var/lib/containers -v /:/target --security-opt label=type:unconfined_t ghcr.io/ublue-os/bluefin:stable bootc install to-existing-root --acknowledge-destructive --skip-fetch-check --stateroot=default --target-imgref=ghcr.io/ublue-os/bluefin:stable\r\n"]
[1.399, "o", "Installing image: docker://ghcr.io/ublue-os/bluefin:stable\r\nDigest: sha256:e4b5303ca69e80245ffd8841e4aacaa906c24a328da0621e970688faa07ce460\r\n"]
