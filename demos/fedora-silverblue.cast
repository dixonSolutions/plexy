[0.051, "o", "\u001b[1;34m::\u001b[0m new deployment: /ostree/deploy/default/deploy/fce653a4f4e213cb8b772001a9c339cc980c6747132fc261e4cd7c63293334ac.0\r\n"]
[0.004, "o", "\u001b[1;34m::\u001b[0m fstab entries carried: 2\r\n\u001b[1;32m==>\u001b[0m \u001b[1mmerging user accounts\u001b[0m\r\n"]
