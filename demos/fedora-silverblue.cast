[0.022, "o", "\u001b[1;34m::\u001b[0m the system will follow quay.io/fedora/fedora-silverblue:44 directly; 3 package(s) are layered with rpm-ostree on first boot\r\n"]
[0.015, "o", "\r\n  About to replace the operating system with quay.io/fedora/fedora-silverblue:44 (Bootc backend).\r\n  /boot and the EFI boot entries will be rewritten; data, accounts and settings are carried over.\r\n  A backup of /boot and the ESP is written to /var/lib/plexy/backup (`plexy rollback` uses it).\r\n"]
[0.021, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mbacking up /boot and the EFI system partition to /var/lib/plexy/backup\u001b[0m\r\n"]
[0.315, "o", "\u001b[1;32m==>\u001b[0m \u001b[1minstalling quay.io/fedora/fedora-silverblue:44 next to the running system (bootc install to-existing-root)\u001b[0m\r\n\u001b[1;34m::\u001b[0m $ podman run --rm --net=none --privileged --pid=host --user=root:root -v /dev:/dev -v /var/lib/containers:/var/lib/containers -v /:/target --security-opt label=type:unconfined_t quay.io/fedora/fedora-silverblue:44 bootc install to-existing-root --acknowledge-destructive --skip-fetch-check --stateroot=default --target-imgref=quay.io/fedora/fedora-silverblue:44 --karg=console=tty1 --karg=console=ttyS0,115200n8 --karg=systemd.firstboot=off\r\n"]
