[0.001, "o", "\u001b[1;34m::\u001b[0m   14 config files written\r\n\u001b[1;32m==>\u001b[0m \u001b[1mre-enabling services\u001b[0m\r\n"]
[0.098, "o", "\u001b[1;34m::\u001b[0m   disabled lvm-devices-import.path (it was disabled on the old system)\r\n"]
[0.005, "o", "\u001b[1;34m::\u001b[0m   disabled lvm-devices-import.service (it was disabled on the old system)\r\n\u001b[1;34m::\u001b[0m   42 units enabled as on the old system\r\n\u001b[1;34m::\u001b[0m   5 units have no counterpart on the target: cloud-config.service cloud-final.service cloud-init-local.service cloud-init-main.service nginx.service\r\n"]
[0.012, "o", "\u001b[1;32m==>\u001b[0m \u001b[1minstalling first-boot and first-login hooks\u001b[0m\r\n"]
[0.001, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mremapping ownership of system accounts (8 uids, 8 gids differ)\u001b[0m\r\n"]
[0.040, "o", "\u001b[1;34m::\u001b[0m   17 files re-owned\r\n\u001b[1;32m==>\u001b[0m \u001b[1mlabelling migrated files with the target's SELinux policy\u001b[0m\r\n\u001b[1;34m::\u001b[0m $ podman run --rm --privileged --net=none --security-opt label=disable -v /ostree/deploy/default/deploy/fce653a4f4e213cb8b772001a9c339cc980c6747132fc261e4cd7c63293334ac.0/etc:/target/etc --mount type=bind,source=/var/roothome,destination=/target/var/roothome,bind-nonrecursive --mount type=bind,source=/var/usrlocal,destination=/target/var/usrlocal,bind-nonrecursive --mount type=bind,source=/var/lib/plexy,destination=/target/var/lib/plexy,bind-nonrecursive --rootfs /ostree/deploy/default/deploy/fce653a4f4e213cb8b772001a9c339cc980c6747132fc261e4cd7c63293334ac.0:O /usr/sbin/setfiles -F -r /target /etc/selinux/targeted/contexts/files/file_contexts /target/etc /target/var/roothome /target/var/usrlocal /target/var/lib/plexy\r\n"]
[0.225, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mmigration staged\u001b[0m\r\n\r\n  The new system is installed and your data has been placed. Reboot to start it.\r\n  The old system's files remain under /sysroot until you run `plexy cleanup`.\r\n\r\n"]
