[0.000, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mlabelling migrated files with the target's SELinux policy\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;34m::\u001b[0m $ podman run --rm --privileged --net=none --security-opt label=disable -v /ostree/deploy/default/deploy/e47a52e72131e5cfaaf656721caf4341e7bafa6236b4d7fa4fc29d2615dbe4f7.0/etc:/target/etc --mount type=bind,source=/ostree/deploy/default/var,destination=/target/var,bind-nonrecursive --mount type=bind,source=/boot,destination=/target/boot,bind-nonrecursive --rootfs /ostree/deploy/default/deploy/e47a52e72131e5cfaaf656721caf4341e7bafa6236b4d7fa4fc29d2615dbe4f7.0:O /usr/sbin/setfiles -F -r /target /etc/selinux/targeted/contexts/files/file_contexts /target/etc /target/var /target/boot\r\n"]
[6.336, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mmigration staged\u001b[0m\r\n\r\n  The new system is installed and your data has been placed. Reboot to start it.\r\n  The old system's files remain under /sysroot until you run `plexy cleanup`.\r\n\r\n"]
[0.003, "o", "\u001b[1;33mwarning:\u001b[0m rebooting past 2 block inhibitor(s) (the migration is staged):\r\ntester 1000 tester 2056 gsd-power      handle-lid-switch                                        External monitor attached or configuration changed recently block\r\ntester 1000 tester 2055 gsd-media-keys handle-power-key:handle-suspend-key:handle-hibernate-key GNOME handling keypresses                                   block\r\n"]
