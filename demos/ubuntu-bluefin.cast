[2.577, "o", "\r\n  source : Ubuntu 26.04.1 LTS (Debian, desktop: GNOME)\r\n  target : bluefin [ghcr.io/ublue-os/bluefin:stable] (Fedora, desktop: GNOME, backend: Bootc)\r\n  mode   : Hybrid\r\n\r\n  already in target image            3 package(s)\r\n  layer into system image            1 package(s)\r\n      nginx\r\n  Homebrew                           2 package(s)\r\n      neovim  ripgrep\r\n  Flatpak                            1 package(s)\r\n      snap:firefox→org.mozilla.firefox\r\n  skip                               3 package(s)\r\n\r\n  config files: 28 → /etc, 0 → toolbox, 0 → brew, 876 skipped\r\n\r\n"]
