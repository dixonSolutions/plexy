[0.062, "o", "\u001b[1;34m::\u001b[0m   24 files re-owned\r\n\u001b[1;32m==>\u001b[0m \u001b[1mlabelling migrated files with the target's SELinux policy\u001b[0m\r\n\u001b[1;34m::\u001b[0m $ podman run --rm --privileged --net=none --security-opt label=disable -v /ostree/deploy/default/deploy/2b64c809580c50dc0802853b1b1502c0e3431477774434ce72edd34a10edc895.0/etc:/target/etc --mount type=bind,source=/var/roothome,destination=/target/var/roothome,bind-nonrecursive --mount type=bind,source=/var/usrlocal,destination=/target/var/usrlocal,bind-nonrecursive --mount type=bind,source=/var/lib/plexy,destination=/target/var/lib/plexy,bind-nonrecursive --rootfs /ostree/deploy/default/deploy/2b64c809580c50dc0802853b1b1502c0e3431477774434ce72edd34a10edc895.0:O /usr/sbin/setfiles -F -r /target /etc/selinux/targeted/contexts/files/file_contexts /target/etc /target/var/roothome /target/var/usrlocal /target/var/lib/plexy\r\n"]
[0.286, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mmigration staged\u001b[0m\r\n\r\n  The new system is installed and your data has been placed. Reboot to start it.\r\n  The old system's files remain under /sysroot until you run `plexy cleanup`.\r\n\r\n"]
