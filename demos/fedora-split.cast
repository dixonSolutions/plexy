[0.006, "o", "\u001b[1;34m::\u001b[0m   disabled lvm-devices-import.service (it was disabled on the old system)\r\n\u001b[1;34m::\u001b[0m   43 units enabled as on the old system\r\n\u001b[1;34m::\u001b[0m   4 units have no counterpart on the target: cloud-config.service cloud-final.service cloud-init-local.service cloud-init-main.service\r\n"]
[0.013, "o", "\u001b[1;32m==>\u001b[0m \u001b[1minstalling first-boot and first-login hooks\u001b[0m\r\n"]
[0.025, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mremapping ownership of system accounts (9 uids, 9 gids differ)\u001b[0m\r\n"]
[0.044, "o", "\u001b[1;34m::\u001b[0m   24 files re-owned\r\n\u001b[1;32m==>\u001b[0m \u001b[1mlabelling migrated files with the target's SELinux policy\u001b[0m\r\n\u001b[1;34m::\u001b[0m $ podman run --rm --privileged --net=none --security-opt label=disable -v /ostree/deploy/default/deploy/3f04c5d516d8f60dfb1fc30ae39312fbaa45c9da94b3f970a9a2344825e99535.0/etc:/target/etc --mount type=bind,source=/var/roothome,destination=/target/var/roothome,bind-nonrecursive --mount type=bind,source=/var/usrlocal,destination=/target/var/usrlocal,bind-nonrecursive --mount type=bind,source=/var/lib/plexy,destination=/target/var/lib/plexy,bind-nonrecursive --rootfs /ostree/deploy/default/deploy/3f04c5d516d8f60dfb1fc30ae39312fbaa45c9da94b3f970a9a2344825e99535.0:O /usr/sbin/setfiles -F -r /target /etc/selinux/targeted/contexts/files/file_contexts /target/etc /target/var/roothome /target/var/usrlocal /target/var/lib/plexy\r\n"]
[0.333, "o", "\u001b[1;32m==>\u001b[0m \u001b[1mmigration staged\u001b[0m\r\n\r\n  The new system is installed and your data has been placed. Reboot to start it.\r\n  The old system's files remain under /sysroot until you run `plexy cleanup`.\r\n\r\n"]
[0.050, "o", "Connection to 127.0.0.1 closed by remote host.\r\n"]
[0.001, "x", "255"]
